<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Window / system splash use the app background colour and no icon; the in-app launch animation (AppLaunchSplash) starts in the very first frame. -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_window_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_window_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>

    <!-- see-through window for the "Quick download" panel that opens over another app -->
    <style name="Theme.MyApplication.Translucent" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
