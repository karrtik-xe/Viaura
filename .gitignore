/app/src/main/res/drawable/viaura_*.xml
# unpacked from app/src/*-src.zip by .github/workflows/build-apk.yml (keeps the file list short)
/app/src/main/java/com/example/lyrics/providers/
/app/src/main/java/com/example/widgets/
/app/src/test/java/

